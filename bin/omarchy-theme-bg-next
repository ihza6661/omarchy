#!/bin/bash

# Cycles through the background images available using swww
# and updates the symlink to the current wallpaper

BACKGROUNDS_DIR="$HOME/.config/omarchy/current/theme/backgrounds/"
CURRENT_BACKGROUND_LINK="$HOME/.config/omarchy/current/background"
TMP_DIR="/tmp/swww-bg"

mkdir -p "$TMP_DIR"

# Get all wallpapers sorted and absolute
mapfile -t BACKGROUNDS < <(find "$BACKGROUNDS_DIR" -type f -print0 | xargs -0 realpath | sort)
TOTAL=${#BACKGROUNDS[@]}

if [[ $TOTAL -eq 0 ]]; then
  notify-send "No background was found for theme" -t 2000
  swww img "#000000" --resize crop
  exit 0
fi

# Ensure swww-daemon is running
if ! pgrep -x swww-daemon >/dev/null; then
  swww init
  sleep 0.5
fi

# Resolve current wallpaper
if [[ -L "$CURRENT_BACKGROUND_LINK" ]]; then
  CURRENT_BACKGROUND=$(realpath "$CURRENT_BACKGROUND_LINK")
else
  CURRENT_BACKGROUND=""
fi

# Find current wallpaper index
INDEX=-1
for i in "${!BACKGROUNDS[@]}"; do
  if [[ "${BACKGROUNDS[$i]}" == "$CURRENT_BACKGROUND" ]]; then
    INDEX=$i
    break
  fi
done

# Determine next wallpaper
if [[ $INDEX -eq -1 ]]; then
  NEW_BACKGROUND="${BACKGROUNDS[0]}"
else
  NEXT_INDEX=$(((INDEX + 1) % TOTAL))
  NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
fi

# Update symlink
ln -nsf "$NEW_BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Copy to unique temp file to force swww reload
UNIQUE_BG="$TMP_DIR/$(date +%s)-$(basename "$NEW_BACKGROUND")"
cp "$NEW_BACKGROUND" "$UNIQUE_BG"

# Apply with transition
swww img "$UNIQUE_BG" \
  --resize crop \
  --transition-type any \
  --transition-duration 1.2 \
  --transition-step 90 \
  --transition-fps 60 \
  --transition-bezier .43,1.19,1,.4

notify-send "Wallpaper changed" "$(basename "$NEW_BACKGROUND")" -t 1500
